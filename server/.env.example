# Copy to .env and fill in. .env is gitignored — never commit real values.

# Dashboard timezone — all calendar day/time math uses this, regardless of the
# host machine's clock (important on a UTC VPS). Defaults to America/Detroit.
DASHBOARD_TZ=America/Detroit

# --- Notion (tasks + projects) ---
NOTION_TOKEN=
NOTION_TASKS_DB_ID=
NOTION_PROJECTS_DB_ID=
# Optional — auto-discovered by title ("Companies") when omitted. Used for logo storage.
NOTION_COMPANIES_DB_ID=

# --- Google Calendar (personal calendar, read-only via personal OAuth token) ---
# Calendar ID is usually your email address (calendar settings → "Integrate calendar")
GOOGLE_CALENDAR_ID=
# Personal Google OAuth token JSON path (shared with Hermes).
# Defaults to /root/.hermes/google_token.json when omitted.
GOOGLE_TOKEN_PATH=/root/.hermes/google_token.json
# Optional if the token JSON does not already include these and needs refresh.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional service-account fallback. The calendar must be shared with the
# service account email with "See all event details".
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Guppy / Hermes (later, once deployed near the agent) ---
GUPPY_API_URL=
GUPPY_API_KEY=
